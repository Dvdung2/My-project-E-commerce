# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# docker-compose reads these variables. NEVER commit real secrets.

# SQL Server SA password (must meet SQL Server complexity rules:
# >= 8 chars, upper + lower + digit + symbol)
SA_PASSWORD=change_me_Strong_Password_123!

# JWT signing key. Use a long random value (>= 32 chars / 256 bits).
# Generate one, e.g.:  openssl rand -base64 48
JWT_KEY=change_me_generate_a_long_random_secret_at_least_32_chars

# Initial admin account, seeded once at startup if no admin exists.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_Admin_Password_123!
SEED_ADMIN_NAME=Shop Admin
